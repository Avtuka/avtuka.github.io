---
import Layout from './Layout.astro';

interface Props {
  appName: string;
  icon: string;
  title: string;
  description: string;
  /**
   * The <h1>. Defaults to "Privacy Policy" so every existing page is unchanged; Beloti's
   * terms of service is the first thing here that is not a privacy policy.
   */
  heading?: string;
}

const { appName, icon, title, description, heading = 'Privacy Policy' } = Astro.props;
---
<Layout title={title} description={description}>
  <div class="page-header">
    <span class="badge">{icon} {appName}</span>
    <h1>{heading}</h1>
    <p class="subtitle">{description}</p>
  </div>

  <slot name="meta" />

  <div class="prose">
    <slot />
  </div>
</Layout>
