---
import Layout from './Layout.astro';

interface Props {
  appName: string;
  icon: string;
  title: string;
  description: string;
}

const { appName, icon, title, description } = Astro.props;
---
<Layout title={title} description={description}>
  <div class="page-header">
    <span class="badge">{icon} {appName}</span>
    <h1>Privacy Policy</h1>
    <p class="subtitle">{description}</p>
  </div>

  <slot name="meta" />

  <div class="prose">
    <slot />
  </div>
</Layout>
